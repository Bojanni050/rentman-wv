{
    "name": "whitevision/rentman-availability-calendar",
    "description": "WordPress plugin for displaying Rentman availability calendar",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "wordpress",
        "plugin",
        "rentman",
        "calendar",
        "availability",
        "booking"
    ],
    "authors": [
        {
            "name": "Bojan Davidovic",
            "email": "bojan@whitevision.nl",
            "homepage": "https://whitevision.nl"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "wp-phpunit/wp-phpunit": "^6.0",
        "phpstan/phpstan": "^1.8",
        "squizlabs/php_codesniffer": "^3.7",
        "wp-cli/wp-cli": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "RAC\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RAC\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse includes/ --level=5",
        "phpcs": "phpcs includes/ --standard=WordPress",
        "phpcbf": "phpcbf includes/ --standard=WordPress"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
